# The address comes from the environment, which is what lets one file serve both
# cases: `localhost` locally, where Caddy issues a local certificate, and a real
# hostname on a server, where it obtains one from Let's Encrypt automatically.
# No edit between the two, so the config that was tested is the config that runs.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Media is content-addressed by path and never mutated in place — a changed
	# image gets a new filename — so it can be cached immutably for a year. This
	# is the single largest win available for a content site, and it is three
	# lines.
	handle_path /media/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy web:3000
	}

	reverse_proxy web:3000
}
