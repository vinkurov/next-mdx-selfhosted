# Address Caddy serves and requests a certificate for.
# `localhost` locally (Caddy issues a local certificate); a real hostname on a
# server. Keeping it in the environment is why the Caddyfile needs no editing
# between the two.
SITE_ADDRESS=localhost

# Base URL every media path is resolved against. Points at the bundled
# `public/media` by default. Moving media to object storage is a change to this
# one variable rather than an edit to every article — see src/content/media.ts.
MEDIA_BASE_URL=/media

# Canonical origin, used for sitemap entries, robots.txt and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
